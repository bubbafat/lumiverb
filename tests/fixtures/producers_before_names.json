 "made": {
  "analysis_proxy": "a.analysis_proxy_key IS NOT NULL",
  "capture": "EXISTS (SELECT 1 FROM artifact_lineage cl WHERE cl.asset_id = a.asset_id AND cl.artifact = 'capture' AND cl.producer <> '')",
  "clip": "EXISTS (SELECT 1 FROM asset_embeddings ae WHERE ae.asset_id = a.asset_id AND ae.model_id = 'clip')",
  "faces": "a.face_count IS NOT NULL",
  "location": "EXISTS (SELECT 1 FROM artifact_lineage ll WHERE ll.asset_id = a.asset_id AND ll.artifact = 'location' AND ll.producer = 'location')",
  "ocr": "EXISTS (SELECT 1 FROM asset_ocr o WHERE o.asset_id = a.asset_id)",
  "probe": "EXISTS (SELECT 1 FROM video_facets vf WHERE vf.asset_id = a.asset_id)",
  "proxy": "a.proxy_key IS NOT NULL",
  "scene_vision": "NOT EXISTS (SELECT 1 FROM video_scenes s WHERE s.asset_id = a.asset_id AND s.description IS NULL AND s.staged IS DISTINCT FROM 'finding')",
  "scenes": "a.video_indexed",
  "transcript": "a.has_transcript IS NOT NULL",
  "video_faces": "a.face_count IS NOT NULL",
  "video_preview": "a.video_preview_key IS NOT NULL",
  "vision": "EXISTS (SELECT 1 FROM asset_metadata am WHERE am.asset_id = a.asset_id)"
 },
