 "applies": {
  "analysis_proxy": "a.media_type = 'video'",
  "capture": "true",
  "clip": "a.media_type = 'image'",
  "faces": "a.media_type = 'image' AND COALESCE((SELECT CAST(sm.value AS jsonb) ->> 'detail' FROM system_metadata sm WHERE sm.key = 'producer.faces'), 'normal') <> 'off'",
  "location": "EXISTS (SELECT 1 FROM libraries il WHERE il.library_id = a.library_id AND il.infer_location) AND a.taken_at IS NOT NULL AND (a.gps_lat IS NULL OR a.gps_lon IS NULL) AND NOT EXISTS (SELECT 1 FROM asset_location pl WHERE pl.asset_id = a.asset_id AND pl.source = 'person')",
  "ocr": "a.media_type = 'image'",
  "probe": "a.media_type = 'video'",
  "proxy": "true",
  "scene_vision": "a.media_type = 'video' AND a.video_indexed AND EXISTS (SELECT 1 FROM video_scenes s WHERE s.asset_id = a.asset_id AND s.staged IS DISTINCT FROM 'finding')",
  "scenes": "a.media_type = 'video' AND a.duration_sec IS NOT NULL",
  "transcript": "a.media_type = 'video' AND a.duration_sec IS NOT NULL",
  "video_faces": "a.media_type = 'video' AND a.video_indexed AND COALESCE((SELECT CAST(sm.value AS jsonb) ->> 'detail' FROM system_metadata sm WHERE sm.key = 'producer.video_faces'), 'low') <> 'off'",
  "video_preview": "a.media_type = 'video'",
  "vision": "a.media_type = 'image'"
 },
